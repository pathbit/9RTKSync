{
  "name": "openspec",
  "description": "Valida e arquiva mudancas nas especificacoes do OpenSpec.",
  "group": "workflow",
  "optIn": true,
  "source": "https://github.com/Fission-AI/OpenSpec",
  "license": "MIT",
  "licenseSource": "https://github.com/Fission-AI/OpenSpec/blob/v2.1.1/LICENSE",
  "download": {
    "provider": "npm",
    "package": "@fission-ai/openspec",
    "registry": "https://registry.npmjs.org/",
    "repository": "Fission-AI/OpenSpec",
    "channel": "latest"
  },
  "platforms": [
    "darwin-arm64",
    "darwin-x64",
    "linux-arm64",
    "linux-x64",
    "win32-arm64",
    "win32-x64"
  ],
  "scripts": {
    "entry": "SCRIPT.mjs"
  },
  "env": {
    "OPENSPEC_TELEMETRY": "0"
  },
  "probe": [
    "--version"
  ]
}
